<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Vehicle Types -->
    <vType id="standard_car" accel="2.6" decel="4.5" sigma="0.5" length="4.8" minGap="2.5" maxSpeed="15.0" guiShape="passenger" color="0.7,0.7,0.7"/>
    <vType id="city_bus" accel="1.2" decel="3.5" sigma="0.5" length="12.0" minGap="3.0" maxSpeed="12.0" guiShape="bus" color="0.2,0.6,0.9"/>
    
    <!-- Emergency Vehicle with Priority & Siren Strobe -->
    <vType id="emergency_ambulance" accel="3.8" decel="6.0" sigma="0.1" length="6.5" minGap="1.5" maxSpeed="22.2" guiShape="emergency" color="1.0,0.1,0.1" speedFactor="1.4">
        <param key="has.bluelight.device" value="true"/>
    </vType>

    <!-- Pedestrian Types -->
    <vType id="standard_pedestrian" vClass="pedestrian" maxSpeed="1.34" width="0.6" length="0.4"/>
    <vType id="elderly_pedestrian" vClass="pedestrian" maxSpeed="0.75" width="0.7" length="0.5" color="0.9,0.5,0.1"/>

    <!-- Corridor Routes -->
    <route id="corridor_eastbound" edges="corr_0_1 corr_1_2 corr_2_3 corr_3_4 corr_4_end"/>
    <route id="cross_route_1" edges="n1_to_int1 int1_to_s1"/>
    <route id="cross_route_2" edges="n2_to_int2 int2_to_s2"/>
    <route id="cross_route_3" edges="n3_to_int3 int3_to_s3"/>
    <route id="cross_route_4" edges="n4_to_int4 int4_to_s4"/>

    <!-- Background Traffic Flow -->
    <flow id="flow_corridor" type="standard_car" route="corridor_eastbound" begin="0" end="1800" period="12"/>
    <flow id="flow_cross_1" type="standard_car" route="cross_route_1" begin="0" end="1800" period="18"/>
    <flow id="flow_cross_2" type="standard_car" route="cross_route_2" begin="0" end="1800" period="20"/>
    <flow id="flow_cross_3" type="standard_car" route="cross_route_3" begin="0" end="1800" period="25"/>
    <flow id="flow_cross_4" type="standard_car" route="cross_route_4" begin="0" end="1800" period="18"/>

    <!-- Emergency Ambulance Vehicle (Dispatched at t=30s) -->
    <vehicle id="AMB-101" type="emergency_ambulance" route="corridor_eastbound" depart="30" departSpeed="12.0"/>
</routes>
